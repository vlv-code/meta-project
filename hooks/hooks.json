{
  "description": "Meta-Project boundary gate and context injector for Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py --harness claude-code --event session-start"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py --harness claude-code --event pre-tool-use --red-policy deny"
      }
    ]
  }
}
